# global options
{
	admin off # theres no need for the admin api in railway's environment
	persist_config off # storage isn't persistent anyway
	auto_https off # railway handles https for us, this could in some cases cause issues if left enabled
	# runtime logs
	log {
		format json # set runtime log format to json mode 
	}
	# server options
	servers {
		trusted_proxies static private_ranges # trust railway's proxy
	}
}

(lb_settings) {
	lb_policy round_robin
	lb_retries 100
	lb_try_duration 10s
	lb_try_interval 250ms
}

(passive_health_checks) {
	fail_duration 60s
	max_fails 300
	unhealthy_latency 5s
	unhealthy_request_count 200
}

# OpenClaw Daytona preview gateway. This listener is intended for Railway
# private networking only. It preserves OpenClaw auth while adding Daytona
# preview auth for the upstream request.
:{$OPENCLAW_GATEWAY_PORT:18789} {
	@authorized header Authorization "Bearer {$OPENCLAW_GATEWAY_TOKEN:openclaw-proxy-not-configured}"
	handle @authorized {
		uri query +DAYTONA_SANDBOX_AUTH_KEY {$DAYTONA_GATEWAY_PREVIEW_TOKEN:openclaw-proxy-not-configured}
		reverse_proxy {$DAYTONA_GATEWAY_PREVIEW_URL:http://127.0.0.1:9} {
			header_up Host {upstream_hostport}
			header_up -x-daytona-preview-token
			header_up x-daytona-preview-token {$DAYTONA_GATEWAY_PREVIEW_TOKEN:openclaw-proxy-not-configured}
		}
	}

	handle {
		respond "unauthorized" 401
	}
}

# OpenClaw agents metadata sidecar for chat roster discovery.
:{$OPENCLAW_METADATA_PORT:18790} {
	@authorized header Authorization "Bearer {$OPENCLAW_GATEWAY_TOKEN:openclaw-proxy-not-configured}"
	handle @authorized {
		uri query +DAYTONA_SANDBOX_AUTH_KEY {$DAYTONA_METADATA_PREVIEW_TOKEN:openclaw-proxy-not-configured}
		reverse_proxy {$DAYTONA_METADATA_PREVIEW_URL:http://127.0.0.1:9} {
			header_up Host {upstream_hostport}
			header_up -x-daytona-preview-token
			header_up x-daytona-preview-token {$DAYTONA_METADATA_PREVIEW_TOKEN:openclaw-proxy-not-configured}
		}
	}

	handle {
		respond "unauthorized" 401
	}
}

# site block, listens on the $PORT environment variable, automatically assigned by railway
:{$PORT:3000} {
	# access logs
	log {
		format json # set access log format to json mode
	}

	# Public Daytona model router path. The router service validates
	# OPENCLAW_MODEL_ROUTER_TOKEN; Caddy only exposes the narrow route and strips
	# this public prefix before proxying to the Railway-private listener.
	handle_path /openclaw-model-router/* {
		reverse_proxy {
			dynamic a {
				name {$OPENCLAW_MODEL_ROUTER_DOMAIN:daytona-openclaw.railway.internal}
				port {$OPENCLAW_MODEL_ROUTER_PORT:18791}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}

	# If we attach a Railway-provided public host for Daytona VM model calls,
	# keep that host scoped to the model-router path only. The normal Studio UI
	# and API stay available only through the Cloudflare-protected hostname.
	@model_router_public_host header Host {$OPENCLAW_MODEL_ROUTER_PUBLIC_HOST:openclaw-model-router-host-not-configured}
	handle @model_router_public_host {
		respond "not found" 404
	}

	handle /agent/* {
		reverse_proxy {
			dynamic a {
				name {$BACKEND_DOMAIN}
				port {$BACKEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}

	handle /ws/doc/* {
		reverse_proxy {
			dynamic a {
				name {$COLLAB_DOMAIN}
				port {$COLLAB_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}

	# Collab's agent-facing HTTP surface mounts at /api/v1 (see
	# studio-os/packages/collab/src/api/server.ts). studio-os's API never
	# claims /api/v1, so we can carve that prefix off for collab. MUST stay
	# above the generic /api/* handle below — Caddy matches handlers in order.
	#
	# NOTE: collab's HTTP /api/v1 listener is a DIFFERENT port from its
	# Hocuspocus WebSocket listener used by /ws/doc/*. The WS route above
	# uses COLLAB_PORT (Hocuspocus, default 3001 in collab). The HTTP API
	# uses COLLAB_API_PORT (default 3003). Same domain, different port.
	handle /api/v1/* {
		reverse_proxy {
			dynamic a {
				name {$COLLAB_DOMAIN}
				port {$COLLAB_API_PORT:3003}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}

	# Preserve the /api prefix. The API process mounts its routes at /api, and
	# JWT-scoped agent callbacks must see the same path public callers use.
	handle {$BACKEND_PATH:/api}/* {
		reverse_proxy {
			dynamic a {
				name {$BACKEND_DOMAIN}
				port {$BACKEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}

	handle /auth/* {
		reverse_proxy {
			dynamic a {
				name {$BACKEND_DOMAIN}
				port {$BACKEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}

	handle {
		reverse_proxy {
			dynamic a {
				name {$FRONTEND_DOMAIN}
				port {$FRONTEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}
}
