# global options
{
	admin off # theres no need for the admin api in railway's environment
	persist_config off # storage isn't persistent anyway
	auto_https off # railway handles https for us, this could in some cases cause issues if left enabled
	# runtime logs
	log {
		format json # set runtime log format to json mode 
	}
	# server options
	servers {
		trusted_proxies static private_ranges # trust railway's proxy
	}
}

(lb_settings) {
	lb_policy round_robin
	lb_retries 100
	lb_try_duration 10s
	lb_try_interval 250ms
}

(passive_health_checks) {
	fail_duration 60s
	max_fails 300
	unhealthy_latency 5s
	unhealthy_request_count 200
}

# OpenClaw Daytona preview gateway. This listener is intended for Railway
# private networking only. It preserves OpenClaw auth while adding Daytona
# preview auth for the upstream request.
:{$OPENCLAW_GATEWAY_PORT:18789} {
	@authorized header Authorization "Bearer {$OPENCLAW_GATEWAY_TOKEN:openclaw-proxy-not-configured}"
	handle @authorized {
		uri query +DAYTONA_SANDBOX_AUTH_KEY {$DAYTONA_GATEWAY_PREVIEW_TOKEN:openclaw-proxy-not-configured}
		reverse_proxy {$DAYTONA_GATEWAY_PREVIEW_URL:http://127.0.0.1:9} {
			header_up Host {upstream_hostport}
			header_up -x-daytona-preview-token
			header_up x-daytona-preview-token {$DAYTONA_GATEWAY_PREVIEW_TOKEN:openclaw-proxy-not-configured}
		}
	}

	handle {
		respond "unauthorized" 401
	}
}

# OpenClaw agents metadata sidecar for chat roster discovery.
:{$OPENCLAW_METADATA_PORT:18790} {
	@authorized header Authorization "Bearer {$OPENCLAW_GATEWAY_TOKEN:openclaw-proxy-not-configured}"
	handle @authorized {
		uri query +DAYTONA_SANDBOX_AUTH_KEY {$DAYTONA_METADATA_PREVIEW_TOKEN:openclaw-proxy-not-configured}
		reverse_proxy {$DAYTONA_METADATA_PREVIEW_URL:http://127.0.0.1:9} {
			header_up Host {upstream_hostport}
			header_up -x-daytona-preview-token
			header_up x-daytona-preview-token {$DAYTONA_METADATA_PREVIEW_TOKEN:openclaw-proxy-not-configured}
		}
	}

	handle {
		respond "unauthorized" 401
	}
}

# site block, listens on the $PORT environment variable, automatically assigned by railway
:{$PORT:3000} {
	# access logs
	log {
		format json # set access log format to json mode
	}

	handle /agent/* {
		reverse_proxy {
			dynamic a {
				name {$BACKEND_DOMAIN}
				port {$BACKEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}

	handle /ws/doc/* {
		reverse_proxy {
			dynamic a {
				name {$COLLAB_DOMAIN}
				port {$COLLAB_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}

	handle_path {$BACKEND_PATH:/api}/* {
		reverse_proxy {
			dynamic a {
				name {$BACKEND_DOMAIN}
				port {$BACKEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}

	handle {
		reverse_proxy {
			dynamic a {
				name {$FRONTEND_DOMAIN}
				port {$FRONTEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}

			import lb_settings
			import passive_health_checks
			header_up Host {upstream_hostport}
		}
	}
}
